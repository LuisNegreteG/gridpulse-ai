// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table rt_price_event_history (event_schema_version:string, event_type:string, event_id:string, observation_hash:string, delivery_date:string, delivery_hour:int, interval:int, zonal_price_capped_cad_per_mwh:decimal, loss_price_capped_cad_per_mwh:decimal, congestion_price_capped_cad_per_mwh:decimal, source_flag:string, publication_state:string, previous_event_id:string, source_name:string, source_file:string, source_url:string, source_hash:string, source_created_at_raw:string, source_doc_revision:string, bronze_first_seen_at_utc:datetime, publisher_run_id:string, poll_id:string, event_created_at_utc:datetime) 
.create-or-alter table rt_price_event_history ingestion json mapping 'rt_price_event_history_json_v1'
```
